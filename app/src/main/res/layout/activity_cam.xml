<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false" />

        <!-- Top-left: menu button -->
        <ImageButton
            android:id="@+id/ibtnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="10dp"
            android:background="@drawable/btn_cam_bg"
            android:padding="4dp"
            android:src="@drawable/ic_menu_btn"
            android:contentDescription="@string/cd_menu" />

        <!-- Top-right: controls bar -->
        <LinearLayout
            android:id="@+id/layout2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/iBtnFlash"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_cam_bg"
                android:contentDescription="@string/cd_flash"
                android:padding="2dp"
                android:src="@drawable/ic_flash_off" />

            <ImageButton
                android:id="@+id/imgZoomIn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_cam_bg"
                android:padding="2dp"
                android:src="@drawable/ic_zoom_in"
                android:contentDescription="@string/cd_zoom_in" />

            <ImageButton
                android:id="@+id/imgFoto"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_cam_bg"
                android:padding="2dp"
                android:src="@drawable/ic_camera"
                android:contentDescription="@string/cd_photo" />

            <ImageButton
                android:id="@+id/iBtnVideo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/btn_cam_bg"
                android:padding="2dp"
                android:src="@drawable/ic_video"
                android:contentDescription="@string/cd_record_video" />

            <ImageButton
                android:id="@+id/imgZoomOut"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_cam_bg"
                android:contentDescription="@string/cd_zoom_out"
                android:padding="2dp"
                android:src="@drawable/ic_zoom_out1" />

        </LinearLayout>

        <!-- Bottom-left: last photo thumbnail -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="90dp"
            android:layout_height="70dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="58dp"
            android:background="@android:color/transparent" />

        <!-- Appodeal Banner Ad -->
        <FrameLayout
            android:id="@+id/appodealBannerView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:background="#F0F0F0" />

    </RelativeLayout>

</LinearLayout>
