# Keystore configuration for MiLupa
# Copy this file to keystore.properties and fill in your credentials
# DO NOT commit keystore.properties to Git (should be in .gitignore)

# Path to keystore file (relative to project root)
storeFile=milupa.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias
keyAlias=YOUR_KEY_ALIAS

# Key password
keyPassword=YOUR_KEY_PASSWORD

